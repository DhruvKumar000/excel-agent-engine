# Copy to .env and fill ONE provider. Leave LLM_API_KEY empty to run in MOCK mode (no key needed).

# --- Option A: Google Gemini (free tier) ---
LLM_API_KEY=AIza...
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# --- Option B: Groq (free tier, very fast) ---
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option C: OpenAI ---
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Option D: Ollama (fully local) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Force rule-based mode even if a key is present
# LLM_MOCK=true
